new file mode 100644
--- /dev/null
+++ b/Sources/OShell/TerminalAppearanceSettings.swift
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import AppKit
+import ImageIO
+import OShellCore
+
+final class TerminalAppearanceSettings: NSView {
+    static let backgroundKey = "OShell.terminal.backgroundFile"
+    private let enabled = NSButton(checkboxWithTitle: "自定义所有终端的外观", target: nil, action: nil)
+    private let fields = NSGridView()
+    private let picture = NSTextField(labelWithString: "")
+    private var path = UserDefaults.standard.string(forKey: backgroundKey)
+    private var readers = [(inout TerminalAppearance) throws -> Void]()
+
+    init(_ saved: TerminalAppearance?) {
+        let initial = saved ?? TerminalAppearance()
+        super.init(frame: NSRect(x: 0, y: 0, width: 820, height: 520))
+        enabled.state = saved == nil ? .off : .on
+        enabled.target = self
+        enabled.action = #selector(toggle)
+        func integer(_ key: WritableKeyPath<TerminalAppearance, Int>, _ title: String) -> NSView {
+            let field = NSTextField(string: String(initial[keyPath: key]))
+            field.setAccessibilityLabel(title)
+            readers.append { draft in
+                guard let number = Int(field.stringValue.trimmingCharacters(in: .whitespaces)) else {
+                    throw ModelError.invalid(title + "需要整数")
+                }
+                draft[keyPath: key] = number
+            }
+            return field
+        }
+        func text(_ key: WritableKeyPath<TerminalAppearance, String>, _ title: String) -> NSView {
+            let field = NSTextField(string: initial[keyPath: key])
+            field.placeholderString = title
+            readers.append { $0[keyPath: key] = field.stringValue.trimmingCharacters(in: .whitespaces) }
+            return field
+        }
+        func menu(_ key: WritableKeyPath<TerminalAppearance, String>, _ choices: [(String, String)]) -> NSView {
+            let button = NSPopUpButton()
+            button.addItems(withTitles: choices.map { $0.1 })
+            button.selectItem(at: choices.firstIndex { $0.0 == initial[keyPath: key] } ?? 0)
+            readers.append { $0[keyPath: key] = choices[button.indexOfSelectedItem].0 }
+            return button
+        }
+        func checkbox(_ key: WritableKeyPath<TerminalAppearance, Bool>, _ title: String) -> NSView {
+            let box = NSButton(checkboxWithTitle: title, target: nil, action: nil)
+            box.state = initial[keyPath: key] ? .on : .off
+            readers.append { $0[keyPath: key] = box.state == .on }
+            return box
+        }
+        func row(_ l: String, _ a: NSView, _ r: String, _ b: NSView) {
+            fields.addRow(with: [NSTextField(labelWithString: l), a, NSTextField(labelWithString: r), b])
+        }
+        row("上边距", integer(\.top, "上边距"), "下边距", integer(\.bottom, "下边距"))
+        row("左边距", integer(\.left, "左边距"), "右边距", integer(\.right, "右边距"))
+        row("行间距", integer(\.lineSpacing, "行间距"), "字符间距", integer(\.characterSpacing, "字符间距"))
+        row("主字体字重", integer(\.fontWeight, "主字体字重"), "", checkbox(\.allowProportional, "允许非等宽字体"))
+        row("东亚字体", text(\.asianFont, "跟随主字体"), "字号（0 跟随）", integer(\.asianSize, "东亚字号"))
+        row("东亚字重（0 跟随）", integer(\.asianWeight, "东亚字重"), "字体质量", menu(\.fontQuality, [("system","系统默认"),("grayscale","灰度抗锯齿")]))
+        row("粗体文本", menu(\.boldStyle, [("both","亮色和粗体"),("font","只使用粗体"),("bright","只使用亮色"),("none","普通字形和颜色")]),
+            "光标形状", menu(\.cursorShape, [("block","块"),("bar","竖线"),("underline","下划线")]))
+        row("", checkbox(\.cursorBlink, "闪烁光标"), "间隔（毫秒）", integer(\.blinkInterval, "闪烁间隔"))
+        row("标签颜色", text(\.tabColor, "#RRGGBB，留空跟随主题"), "图片位置", menu(\.imagePosition, [("center","居中"),("fit","适应窗口"),("fill","铺满并裁剪"),("stretch","拉伸")]))
+        row("本机背景", NSButton(title: "选择图片…", target: self, action: #selector(choosePicture)), "",
+            NSButton(title: "清除图片", target: self, action: #selector(clearPicture)))
+        fields.rowSpacing = 8
+        fields.columnSpacing = 12
+        let hint = NSTextField(wrappingLabelWithString: "边距 0–128，间距 −5–32，字重 100–900，字号 10–26，闪烁间隔 100–2000 毫秒。同步扩展外观需要两端支持，图片在各设备分别选择。")
+        let stack = NSStackView(views: [enabled, fields, picture, hint])
+        stack.orientation = .vertical
+        stack.alignment = .leading
+        stack.spacing = 12
+        stack.translatesAutoresizingMaskIntoConstraints = false
+        addSubview(stack)
+        NSLayoutConstraint.activate([
+            stack.leadingAnchor.constraint(equalTo: leadingAnchor, constant: 20),
+            stack.topAnchor.constraint(equalTo: topAnchor, constant: 16),
+            stack.trailingAnchor.constraint(lessThanOrEqualTo: trailingAnchor, constant: -20),
+            hint.widthAnchor.constraint(lessThanOrEqualToConstant: 730)
+        ])
+        refreshPicture()
+        toggle()
+    }
+    required init?(coder: NSCoder) { fatalError("init(coder:) has not been implemented") }
+    @objc private func toggle() { fields.isHidden = enabled.state != .on; picture.isHidden = fields.isHidden }
+    private func refreshPicture() { picture.stringValue = path.map { URL(fileURLWithPath: $0).lastPathComponent } ?? "" }
+    @objc private func clearPicture() { path = nil; refreshPicture() }
+    @objc private func choosePicture() {
+        let panel = NSOpenPanel()
+        panel.allowedFileTypes = ["png", "jpg", "jpeg", "gif", "bmp", "webp"]
+        guard panel.runPopupModal() == .OK, let url = panel.url else { return }
+        guard Self.backgroundImage(at: url.path) != nil else { Dialogs.message("无法读取背景图片，或已超过大小限制。"); return }
+        path = url.path
+        refreshPicture()
+    }
+    static func backgroundImage(at path: String) -> CGImage? {
+        let url = URL(fileURLWithPath: path)
+        guard let values = try? url.resourceValues(forKeys: [.isRegularFileKey, .fileSizeKey]),
+              values.isRegularFile == true, let bytes = values.fileSize, bytes <= 16 << 20,
+              let source = CGImageSourceCreateWithURL(url as CFURL, nil),
+              let properties = CGImageSourceCopyPropertiesAtIndex(source, 0, nil) as? [String: Any],
+              let w = properties[kCGImagePropertyPixelWidth as String] as? Int,
+              let h = properties[kCGImagePropertyPixelHeight as String] as? Int,
+              w > 0, h > 0, w <= (16 << 20) / h else { return nil }
+        let options: [CFString: Any] = [kCGImageSourceCreateThumbnailFromImageAlways: true,
+                                        kCGImageSourceCreateThumbnailWithTransform: true,
+                                        kCGImageSourceThumbnailMaxPixelSize: max(w,h)]
+        return CGImageSourceCreateThumbnailAtIndex(source, 0, options as CFDictionary)
+    }
+    func saveBackground() {
+        if let path { UserDefaults.standard.set(path, forKey: Self.backgroundKey) }
+        else { UserDefaults.standard.removeObject(forKey: Self.backgroundKey) }
+    }
+    func value() throws -> TerminalAppearance? {
+        guard enabled.state == .on else { return nil }
+        var draft = TerminalAppearance()
+        for read in readers { try read(&draft) }
+        try draft.validate()
+        return draft
+    }
+}
