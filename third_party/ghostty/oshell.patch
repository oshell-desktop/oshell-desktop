+    const narrow = origin.?.node.page().oshellSemantic(origin.?.rowAndCell().row);
+    try testing.expectEqual(@as(u16, 0), narrow.mark(.initial).?.column);
+    try testing.expectEqual(@as(u16, 1), narrow.mark(.right).?.column);
+    try t.resize(alloc, .{ .cols = 8, .rows = 5 });
+    const merged = s.pages.getTopLeft(.screen);
+    const meta = merged.node.page().oshellSemantic(merged.rowAndCell().row);
+    try testing.expectEqual(first_identity, meta.id);
+    try testing.expectEqual(@as(u16, 3), meta.mark(.initial).?.column);
+    try testing.expectEqual(@as(u16, 4), meta.mark(.right).?.column);
