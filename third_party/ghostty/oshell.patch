+        try testing.expect(!oshellOptionsValid(raw));
+    }
+    for ([_][]const u8{ "", ";;;", "bare", "unknown=value", "unknown=中文", "k=i;k=r", "cl=line;cl=m;cl=v;cl=w", "click_events=0;click_events=2", "special_key=0;special_key=1" }) |raw| {
+        try testing.expect(oshellOptionsValid(raw));
+    }
+}
+
+test "OSC 133: malformed known options reject every action" {
