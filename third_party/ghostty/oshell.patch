+test "Terminal: OShell OSC 133 derived row epochs and mark precedence" {
+    const alloc = testing.allocator;
+    var t = try init(testing.io, alloc, .{ .cols = 12, .rows = 6 });
+    defer t.deinit(alloc);
+    t.oshell_reset_compatibility = true;
+    const s = t.screens.active;
+    var pins: [6]PageList.Pin = undefined;
+    var metas: [6]*pagepkg.OshellSemanticRow = undefined;
+    for (0..6) |i| {
+        pins[i] = s.pages.pin(.{ .screen = .{ .y = @intCast(i) } }).?;
+        metas[i] = pins[i].node.page().oshellSemantic(pins[i].rowAndCell().row);
+        // Deliberately stale legacy tags must not influence the query.
+        pins[i].rowAndCell().row.semantic_prompt = .prompt;
+    }
+    metas[0].set(.initial, 0, 1);
+    for (1..4) |i| {
+        metas[i].has_hard_group = true;
+        metas[i].hard_group = 1;
+    }
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.prompt_continuation, s.oshellSemanticRowKind(pins[3]));
+    metas[2].hard_group = 2;
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.none, s.oshellSemanticRowKind(pins[3]));
+    // Soft continuation ignores an obsolete hard epoch on the same row.
+    pins[2].rowAndCell().row.wrap_continuation = true;
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.prompt_continuation, s.oshellSemanticRowKind(pins[3]));
+    pins[2].rowAndCell().row.wrap_continuation = false;
+    metas[2].set(.right, 5, 1);
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.prompt_continuation, s.oshellSemanticRowKind(pins[3]));
+    metas[2].set(.secondary, 5, 2);
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.prompt_continuation, s.oshellSemanticRowKind(pins[3]));
+    metas[2].set(.right, 5, 1); // tie now selects secondary group 2
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.none, s.oshellSemanticRowKind(pins[3]));
+    metas[2].set(.initial, 9, 1); // initial wins regardless of mark column
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.prompt_continuation, s.oshellSemanticRowKind(pins[3]));
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.none, s.oshellSemanticRowKind(pins[4]));
+    metas[5].set(.secondary, 0, 3);
+    s.semantic_prompt.origin_id = metas[5].ensureIdentity();
+    s.semantic_prompt.active_group = 3;
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.prompt, s.oshellSemanticRowKind(pins[5]));
+    s.semantic_prompt.origin_id = metas[0].ensureIdentity();
+    s.semantic_prompt.active_group = 1;
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.prompt_continuation, s.oshellSemanticRowKind(pins[5]));
+    metas[0].set(.initial, 0, 0);
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.prompt, s.oshellSemanticRowKind(pins[0]));
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.none, s.oshellSemanticRowKind(pins[1]));
+}
+
+test "Terminal: OShell OSC 133 derived rows cross physical pages" {
+    const alloc = testing.allocator;
+    var t = try init(testing.io, alloc, .{ .cols = 80, .rows = 5 });
+    defer t.deinit(alloc);
+    t.oshell_reset_compatibility = true;
+    const s = t.screens.active;
+    const count: usize = s.pages.pages.first.?.page().capacity.rows + 3;
+    for (0..count) |_| {
+        try t.printString("x");
+        t.carriageReturn();
+        try t.linefeed();
+    }
+    var it = s.pages.getTopLeft(.screen).rowIterator(.right_down, null);
+    var last = s.pages.getTopLeft(.screen);
+    var first = true;
+    while (it.next()) |p| {
+        const m = p.node.page().oshellSemantic(p.rowAndCell().row);
+        if (first) {
+            m.set(.initial, 0, 42);
+            first = false;
+        } else {
+            m.has_hard_group = true;
+            m.hard_group = 42;
+        }
+        last = p;
+    }
+    try testing.expect(last.node != s.pages.getTopLeft(.screen).node);
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.prompt_continuation, s.oshellSemanticRowKind(last));
+    s.pages.getTopLeft(.screen).node.page().oshellSemantic(s.pages.getTopLeft(.screen).rowAndCell().row).present = 0;
+    try testing.expectEqual(pagepkg.Row.SemanticPrompt.none, s.oshellSemanticRowKind(last));
+}
