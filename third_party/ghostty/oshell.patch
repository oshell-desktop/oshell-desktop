+test "OSC 133 margin mark interval overlap origin priority and continuation" {
+    const M = OshellSemanticRow;
+    var src: M = .{ .id = 1, .hard_group = 71, .has_hard_group = true };
+    var dst: M = .{ .id = 2, .hard_group = 72, .has_hard_group = true };
+    src.set(.initial, 1, 81);
+    src.set(.secondary, 5, 81);
+    dst.set(.secondary, 9, 82);
+    // The initial outside the copied range wins origin-kind selection; a
+    // secondary on the same origin line cannot displace a stationary mark.
+    try testing.expect(!dst.moveRangeFrom(&src, 4, 3, 3, 12, 1));
+    try testing.expect(src.mark(.secondary) == null);
+    try testing.expectEqual(@as(u16, 9), dst.mark(.secondary).?.column);
+    try testing.expectEqual(@as(u64, 72), dst.hard_group);
+    try testing.expect(src.has_hard_group);
+    src.present = 0;
+    src.set(.secondary, 5, 81);
+    try testing.expect(dst.moveRangeFrom(&src, 4, 3, 3, 12, 1));
+    try testing.expectEqual(@as(u16, 4), dst.mark(.secondary).?.column);
+    try testing.expectEqual(@as(u64, 81), dst.mark(.secondary).?.group);
+    try testing.expectEqual(@as(u64, 2), dst.id);
+    try testing.expectEqual(@as(u64, 1), src.id);
+    // A stationary live origin wins an incoming same-kind old group.
+    src.set(.secondary, 5, 99);
+    try testing.expect(!dst.moveRangeFrom(&src, 4, 7, 2, 12, 2));
+    try testing.expectEqual(@as(u64, 81), dst.mark(.secondary).?.group);
+    // Destination-range marks are erased even when no source marks move.
+    try testing.expect(!dst.moveRangeFrom(&src, 4, 3, 3, 12, 0));
+    try testing.expect(dst.mark(.secondary) == null);
+    // A full-width margin copy moves the hard epoch but never line identity.
+    src.set(.right, 11, 81);
+    try testing.expect(!dst.moveRangeFrom(&src, 0, 0, 12, 12, 0));
+    try testing.expectEqual(@as(u64, 71), dst.hard_group);
+    try testing.expect(dst.has_hard_group);
+    try testing.expect(!src.has_hard_group);
+    try testing.expectEqual(@as(u64, 2), dst.id);
+    try testing.expectEqual(@as(u64, 1), src.id);
+    try testing.expectEqual(@as(u16, 11), dst.mark(.right).?.column);
+    // Same-line overlapping moves remove the union of the two intervals,
+    // then restore only the snapshotted source marks at their new columns.
+    dst.set(.initial, 2, 81);
+    dst.set(.secondary, 5, 81);
+    try testing.expect(!dst.moveRangeFrom(&dst, 1, 4, 3, 12, 2));
+    try testing.expectEqual(@as(u16, 5), dst.mark(.initial).?.column);
+    try testing.expect(dst.mark(.secondary) == null);
+    try testing.expectEqual(@as(u16, 11), dst.mark(.right).?.column);
+    try testing.expect(!dst.moveRangeFrom(&dst, 4, 1, 3, 12, 2));
+    try testing.expectEqual(@as(u16, 2), dst.mark(.initial).?.column);
+    try testing.expect(!dst.moveRangeFrom(&dst, 0, 0, 12, 12, 2));
