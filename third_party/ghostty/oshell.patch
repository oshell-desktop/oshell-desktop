+test "OSC 133 page metadata owns marks across clone rotation and recycle" {
+    var p = try Page.init(.{ .cols = 12, .rows = 2 });
+    defer p.deinit();
+    const rows = p.rows.ptr(p.memory)[0..2];
+    const meta = p.oshellSemantic(&rows[0]);
+    meta.id = 42;
+    meta.set(.initial, 10, 7);
+    meta.set(.right, 11, 7);
+    p.clearCells(&rows[0], 0, 12);
+    try testing.expectEqual(@as(u16, 10), meta.mark(.initial).?.column);
+    std.mem.swap(Row, &rows[0], &rows[1]);
+    try testing.expectEqual(@as(u64, 42), p.oshellSemantic(&rows[1]).id);
+    var copy = try p.clone();
+    defer copy.deinit();
+    const copied = copy.oshellSemantic(&copy.rows.ptr(copy.memory)[1]);
+    copied.set(.initial, 3, 8);
+    try testing.expectEqual(@as(u16, 10), meta.mark(.initial).?.column);
+    var narrow = try Page.init(.{ .cols = 6, .rows = 1 });
+    defer narrow.deinit();
+    const target = &narrow.rows.ptr(narrow.memory)[0];
+    try narrow.cloneRowFrom(&p, target, &rows[1]);
+    try testing.expectEqual(@as(u16, 5), narrow.oshellSemantic(target).mark(.initial).?.column);
+    try testing.expectEqual(@as(u64, 42), narrow.oshellSemantic(target).id);
+    narrow.resetRow(target);
+    try testing.expectEqual(@as(u64, 0), narrow.oshellSemantic(target).id);
+    try testing.expect(narrow.oshellSemantic(target).mark(.initial) == null);
+    p.reinit();
+    try testing.expect(p.oshellSemantic(&p.rows.ptr(p.memory)[0]).mark(.initial) == null);
