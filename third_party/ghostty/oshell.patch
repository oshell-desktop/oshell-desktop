+test "OSC 133 joining mark stable order after remark clamp shift and move" {
+    for ([_]OshellSemanticRow{ .{}, std.mem.zeroes(OshellSemanticRow) }) |empty| {
+        var row = empty;
+        row.set(.secondary, 7, 1);
+        row.set(.right, 7, 2);
+        try testing.expectEqual(@as(?u64, 1), row.joiningGroup());
+        row.set(.secondary, 7, 3);
+        try testing.expectEqual(@as(?u64, 2), row.joiningGroup());
+        row.set(.secondary, 2, 4);
+        row.shift(0, 10, 10);
+        try testing.expectEqual(@as(?u64, 4), row.joiningGroup());
+        row.clamp(1);
+        try testing.expectEqual(@as(?u64, 4), row.joiningGroup());
+        var dest: OshellSemanticRow = .{};
+        _ = dest.moveRangeFrom(&row, 0, 0, 1, 1, 0);
+        try testing.expectEqual(@as(?u64, 4), dest.joiningGroup());
+        try testing.expectEqual(@as(?u64, null), row.joiningGroup());
+        dest.set(.secondary, 0, 0);
+        try testing.expectEqual(@as(?u64, 2), dest.joiningGroup());
+        dest.set(.right, 0, 0);
+        try testing.expectEqual(@as(?u64, null), dest.joiningGroup());
+        dest.set(.initial, 0, 5);
+        try testing.expectEqual(@as(?u64, null), dest.joiningGroup());
+    }
