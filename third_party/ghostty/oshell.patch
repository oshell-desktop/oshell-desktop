+fn oshellControlScalar(cp: u21) bool {
+    return cp < 0x20 or (cp >= 0x7f and cp <= 0x9f);
+}
+
+fn oshellContainsControlScalars(text: []const u8) bool {
+    const view = std.unicode.Utf8View.init(text) catch return true;
+    var it = view.iterator();
+    while (it.nextCodepoint()) |cp| {
+        if (oshellControlScalar(cp)) return true;
+    }
+    return false;
+}
+
+// Swift's legacyTextKeySequence is used for Unicode keys when Kitty has
+// neither disambiguation nor report-all. Lock bits do not alter this path.
+fn oshellLegacyTextKey(writer: *std.Io.Writer, event: key.KeyEvent) std.Io.Writer.Error!bool {
+    const mods = event.mods;
+    if (event.action == .release or event.unshifted_codepoint == 0 or
+        mods.super or (mods.ctrl and mods.shift)) return false;
+    if (mods.alt) try writer.writeByte(0x1b);
+    const cp = event.unshifted_codepoint;
+    const lower: u21 = switch (cp) {
+        'A'...'Z' => cp + 32,
+        0x130 => 'i', // Swift lowercase starts with i, followed by a dot.
+        0x212a => 'k',
+        else => cp,
+    };
+    if (mods.ctrl) {
+        const mapped: ?u8 = switch (lower) {
+            'a'...'z' => @intCast(lower - 'a' + 1),
+            ' ', '2', '@' => 0,
+            '3', '[' => 27,
+            '4', '\\' => 28,
+            '5', ']' => 29,
+            '6', '^', '~' => 30,
+            '7', '/', '_' => 31,
+            '8', '?' => 127,
+            '0', '1', '9' => @intCast(lower),
+            else => null,
+        };
+        if (mapped) |value| {
+            try writer.writeByte(value);
+            return true;
+        }
+    }
+    if (event.utf8.len > 0) {
+        try writer.writeAll(event.utf8);
+    } else {
+        var buf: [4]u8 = undefined;
+        const output = if (mods.shift and event.oshell_alternates and event.oshell_shifted_codepoint != 0)
+            event.oshell_shifted_codepoint else cp;
+        const n = std.unicode.utf8Encode(output, &buf) catch return true;
+        try writer.writeAll(buf[0..n]);
+    }
+    return true;
+}
