+/// Match SwiftTerm's actual DECCRA defaults, including its parameter-count
+/// and final-source-column boundaries, rather than imposing standard defaults.
+pub fn oshellRectangleCopy(self: *Terminal, values: []const u16) !void {
+    var params: [8]usize = .{ 1, 1, self.rows - 1, self.cols - 1, 1, 1, 1, 1 };
+    for (&params, 0..) |*param, parameter_index| {
+        if (values.len > parameter_index + 1 and values[parameter_index] != 0) param.* = values[parameter_index];
+    }
+    if (params[4] != 1 or params[7] != 1) return;
+    const geometry: [4]u16 = .{ @intCast(params[0]), @intCast(params[1]), @intCast(params[2]), @intCast(params[3]) };
+    const rect = self.oshellRectangle(&geometry) orelse return;
+    const target_y = @min(self.rows - 1, params[5] - 1);
+    const target_x = @min(self.cols - 1, params[6] - 1);
+    const right = @min(self.cols - 1, rect.left + @min(rect.right - rect.left + 1, self.cols - target_x));
+    const width = right - rect.left;
+    if (width == 0) return;
+    const height = @min(rect.bottom - rect.top + 1, self.rows - target_y);
+    const screen = self.screens.active;
+    const Snapshot = struct { page: Page, start: usize, count: usize };
+    var snapshots: std.ArrayList(Snapshot) = .empty;
+    defer {
+        for (snapshots.items) |*snapshot| snapshot.page.deinit();
+        snapshots.deinit(screen.alloc);
+    }
+    const first = screen.pages.pin(.{ .active = .{ .x = 0, .y = @intCast(rect.top) } }).?;
+    const last = screen.pages.pin(.{ .active = .{ .x = 0, .y = @intCast(rect.top + height - 1) } }).?;
+    var rows = first.rowIterator(.right_down, last);
+    var previous: ?*PageList.List.Node = null;
+    var count: usize = 0;
+    while (rows.next()) |pin| {
+        if (count == height) break;
+        if (previous != pin.node) {
+            var copy = try pin.node.page().clone();
+            snapshots.append(screen.alloc, .{ .page = copy, .start = pin.y, .count = 0 }) catch |err| {
+                copy.deinit();
+                return err;
+            };
+            previous = pin.node;
+        }
+        snapshots.items[snapshots.items.len - 1].count += 1;
+        count += 1;
+    }
+    const x = screen.cursor.x;
+    const y = screen.cursor.y;
+    const pending = screen.cursor.pending_wrap;
+    defer {
+        screen.cursorAbsolute(x, y);
+        screen.cursor.pending_wrap = pending;
+    }
+    const shift = (target_x + self.cols - rect.left) % self.cols;
+    var destination = target_y;
+    for (snapshots.items) |*snapshot| {
+        for (snapshot.start..snapshot.start + snapshot.count) |source_y| {
+            const row = snapshot.page.getRow(source_y);
+            snapshot.page.oshellRotateSnapshotRow(row, shift);
+            screen.cursorAbsolute(@intCast(target_x), @intCast(destination));
+            try screen.oshellCopyRectangleRow(&snapshot.page, row, target_x, width);
+            destination += 1;
+        }
+    }
+}
