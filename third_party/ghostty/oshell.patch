+/// SwiftTerm erases cells without moving the logical cursor or respecting
+/// selective protection. EL preserves line continuations; ED hardens only
+/// the boundaries specified by its direction.
+pub fn oshellErase(self: *Terminal, final: u8, mode: usize) void {
+    if (mode > (if (final == 'J') @as(usize, 3) else 2)) return;
+    const screen = self.screens.active;
+    const x = screen.cursor.x;
+    const y = screen.cursor.y;
+    const pending = screen.cursor.pending_wrap;
+    const logical_x: usize = @as(usize, x) + @intFromBool(pending);
+    defer {
+        screen.cursorAbsolute(x, y);
+        screen.cursor.pending_wrap = pending;
+    }
+    if (final == 'K') {
+        self.oshellEraseRow(y, if (mode == 0) logical_x else 0, if (mode == 1) logical_x + 1 else self.cols, false);
+        return;
+    }
+    switch (mode) {
+        0 => {
+            self.oshellEraseRow(y, logical_x, self.cols, logical_x == 0);
+            for (@as(usize, y) + 1..self.rows) |row|
+                self.oshellResetRow(row);
+        },
+        1 => {
+            self.oshellEraseRow(y, 0, logical_x + 1, true);
+            if (logical_x + 1 >= self.cols and y + 1 < self.rows)
+                self.oshellBreakRowSeam(@as(usize, y) + 1);
+            for (0..y) |row| self.oshellResetRow(row);
+        },
+        2 => self.oshellEraseDisplayComplete(false),
+        3 => if (screen.pages.total_rows > screen.pages.rows) {
+            screen.oshellPreserveSelectionCoordinates();
+            screen.eraseHistory(null);
+        },
+        else => unreachable,
+    }
+}
+
+fn oshellResetRow(self: *Terminal, row: usize) void {
+    self.oshellEraseRow(row, 0, self.cols, true);
+    self.screens.active.cursorAbsolute(0, @intCast(row));
+    self.screens.active.cursor.page_row.oshell_render_mode = 0;
+    if (self.oshell_bidi_enabled) self.screens.active.cursor.page_row.oshell_bidi_state = self.oshell_bidi_state;
+}
+
+fn oshellEraseRow(self: *Terminal, row: usize, start: usize, end: usize, clear_wrap: bool) void {
+    const screen = self.screens.active;
+    const left = @min(start, self.cols);
+    const right = @min(end, self.cols);
+    screen.cursorAbsolute(0, @intCast(row));
+    if (left < right) {
+        // Keep multi-cell glyphs well formed even when an erase cuts an edge.
+        screen.splitCellBoundary(@intCast(left));
+        screen.splitCellBoundary(@intCast(right));
+        const page = screen.cursor.page_pin.node.page();
+        const line = screen.cursor.page_row;
+        screen.clearCells(page, line, page.getCells(line)[left..right]);
+        screen.cursorMarkDirty();
+    }
+    if (clear_wrap) self.oshellBreakRowSeam(row);
+}
