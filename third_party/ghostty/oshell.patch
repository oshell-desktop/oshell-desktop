+    /// Move zero-width marks with a cell interval, preserving line identity.
+    /// Origin liveness is read from the stored identity only: a move must not
+    /// invoke Screen's searching/rebinding getter midway through a scroll.
+    /// Returns true when the live origin moved to a different line.
+    pub fn moveRangeFrom(
+        self: *OshellSemanticRow,
+        source: *OshellSemanticRow,
+        src_col: usize,
+        dst_col: usize,
+        len: usize,
+        cols: usize,
+        origin_id: u64,
+    ) bool {
+        if (len == 0) return false;
+        const before = source.*;
+        const src_origin = origin_id != 0 and before.id == origin_id;
+        const dst_origin = origin_id != 0 and self.id == origin_id;
+        const origin: ?*const OshellSemanticRow = if (src_origin) &before else if (dst_origin) self else null;
+        const origin_kind: ?Kind = if (origin) |row|
+            (if (row.mark(.initial) != null) .initial else if (row.mark(.secondary) != null) .secondary else null)
+        else
+            null;
+        for ([_]Kind{ .initial, .right, .secondary }) |kind| {
+            if (source.mark(kind)) |m| {
+                if (m.column >= src_col and m.column < src_col + len)
+                    source.present &= ~(@as(u3, 1) << @intFromEnum(kind));
+            }
+            if (self.mark(kind)) |m| {
+                if (m.column >= dst_col and m.column < dst_col + len)
+                    self.present &= ~(@as(u3, 1) << @intFromEnum(kind));
+            }
+        }
+        var origin_moved = false;
+        for (before.orderedKinds()) |kind| {
+            const mark_before = before.mark(kind) orelse continue;
+            if (mark_before.column < src_col or mark_before.column >= src_col + len) continue;
+            const is_origin = origin_kind != null and origin_kind.? == kind;
+            const moved_is_origin = src_origin and is_origin;
+            const stationary_is_origin = dst_origin and is_origin;
+            // Stationary same-kind marks outside the interval win unless the
+            // incoming mark is the live origin and the stationary one is not.
+            if (self.mark(kind) != null and !(moved_is_origin and !stationary_is_origin)) continue;
+            self.set(kind, @intCast(mark_before.column - src_col + dst_col), mark_before.group);
+            origin_moved = origin_moved or moved_is_origin;
+        }
+        if (src_col == 0 and dst_col == 0 and len >= cols) {
+            self.hard_group = before.hard_group;
+            self.has_hard_group = before.has_hard_group;
+            if (source != self) {
+                source.hard_group = 0;
+                source.has_hard_group = false;
+            }
+        }
+        return origin_moved and source != self;
+    }
