+        if (y < rect.top) continue;
+        if (y > rect.bottom) break;
+        const page = pin.node.page();
+        for (pin.cells(.all)[rect.left .. rect.right + 1]) |*cell| {
+            const cp = cell.codepoint();
+            if (cp == 0) {
+                sum +%= 32;
+                continue;
+            }
+            sum +%= cp;
+            if (page.lookupGrapheme(cell)) |extra| for (extra) |scalar| {
+                sum +%= scalar;
+            };
+        }
+    }
+    return sum;
