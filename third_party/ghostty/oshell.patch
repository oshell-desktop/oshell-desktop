+/// DECIC affects every row in the vertical region even when the cursor is
+/// outside it. DECDC additionally requires the cursor to be inside that region.
+pub fn oshellColumns(self: *Terminal, insert: bool, count: usize) void {
+    const screen = self.screens.active;
+    const x = screen.cursor.x;
+    const y = screen.cursor.y;
+    const pending = screen.cursor.pending_wrap;
+    const logical_x: usize = @as(usize, x) + @intFromBool(pending);
+    const region = self.scrolling_region;
+    if (logical_x >= self.cols) return;
+    if (insert) {
+        if (logical_x > self.oshellLogicalRegion().right) return;
+    } else if (y < region.top or y > region.bottom) return;
+    if (self.modes.get(.enable_left_and_right_margin) and (logical_x < region.left or logical_x > region.right)) return;
+    const old_erase = screen.oshell_default_erase;
+    screen.oshell_default_erase = insert;
+    defer {
+        screen.oshell_default_erase = old_erase;
+        screen.cursorAbsolute(x, y);
+        screen.cursor.pending_wrap = pending;
+    }
+    for (region.top..@as(usize, region.bottom) + 1) |row| {
+        screen.cursorAbsolute(@intCast(logical_x), @intCast(row));
+        if (insert) self.insertBlanks(count) else self.deleteChars(count);
+        self.oshellBreakRowSeam(row);
+    }
+}
