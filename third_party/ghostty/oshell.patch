+pub fn oshellScrollLogicalSelection(self: *Screen, top: usize, bottom: usize, lines: i64, columns: ?[2]usize) bool {
+    const logical = if (self.oshell_logical_selection) |*v| v else return false;
+    const range = logical.ordered();
+    const intersects = range.start.row <= bottom and range.end.row >= top;
+    if (columns) |c| logical.columnScroll(top, bottom, c[0], c[1]) else logical.scroll(top, bottom, lines);
+    self.dirty.selection = true;
+    if (!logical.active) {
+        self.clearSelection();
+        self.oshell_selection_epoch +%= 1;
+        return true;
+    }
+    if (intersects and columns == null) {
+        var it = self.oshell_gesture_coordinates.iterator();
+        while (it.next()) |entry| {
+            const pos = entry.value_ptr;
+            if (pos.row < top or pos.row > bottom) continue;
+            const y = @as(i128, @intCast(pos.row)) - lines;
+            if (y < top or y > bottom) {
+                entry.key_ptr.*.garbage = true;
+                // Keep the coordinate outside storage; the epoch/selection
+                // governs whether this gesture remains meaningful.
+            } else pos.row = @intCast(y);
+        }
+    }
