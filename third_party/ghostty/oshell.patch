+// OShell's keypad functional path uses the actual translated text (not a
+// fixed US decimal separator), and application-keypad is independent of
+// application-cursor. Locks do not modify legacy functional sequences.
+fn oshellLegacyKeypad(writer: *std.Io.Writer, event: key.KeyEvent, opts: Options) std.Io.Writer.Error!bool {
+    const app_final: u8 = switch (event.key) {
+        .numpad_0, .numpad_insert => 'p',
+        .numpad_1, .numpad_end => 'q',
+        .numpad_2, .numpad_down => 'r',
+        .numpad_3, .numpad_page_down => 's',
+        .numpad_4, .numpad_left => 't',
+        .numpad_5, .numpad_begin => 'u',
+        .numpad_6, .numpad_right => 'v',
+        .numpad_7, .numpad_home => 'w',
+        .numpad_8, .numpad_up => 'x',
+        .numpad_9, .numpad_page_up => 'y',
+        .numpad_decimal, .numpad_delete => 'n',
+        .numpad_divide => 'o',
+        .numpad_multiply => 'j',
+        .numpad_subtract => 'm',
+        .numpad_add => 'k',
+        .numpad_enter => 'M',
+        .numpad_equal => 'X',
+        .numpad_separator => 'l',
+        else => return false,
+    };
+    const mods = event.mods.binding();
+    if (mods.super) return true;
+    if (opts.keypad_key_application and mods.empty()) {
+        try writer.print("\x1bO{c}", .{app_final});
+        return true;
+    }
+    if (event.key == .numpad_enter or event.utf8.len > 0) {
+        if (mods.alt) try writer.writeByte(0x1b);
+        if (event.key == .numpad_enter) {
+            try writer.writeByte('\r');
+        } else {
+            try writer.writeAll(event.utf8);
+        }
+        return true;
+    }
+    const final: ?u8 = switch (event.key) {
+        .numpad_left => 'D',
+        .numpad_right => 'C',
+        .numpad_up => 'A',
+        .numpad_down => 'B',
+        .numpad_home => 'H',
+        .numpad_end => 'F',
+        else => null,
+    };
+    const m = CsiUMods.fromInput(mods).seqInt();
+    if (final) |f| {
+        if (m == 1) try writer.print("\x1b[{c}", .{f}) else try writer.print("\x1b[1;{d}{c}", .{ m, f });
+    } else {
+        const n: ?u8 = switch (event.key) {
+            .numpad_insert => 2,
+            .numpad_delete => 3,
+            .numpad_page_up => 5,
+            .numpad_page_down => 6,
+            else => null,
+        };
+        if (n) |value| {
+            if (m == 1) try writer.print("\x1b[{d}~", .{value}) else try writer.print("\x1b[{d};{d}~", .{ value, m });
+        }
+    }
+    return true;
+}
