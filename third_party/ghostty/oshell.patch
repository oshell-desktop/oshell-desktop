+/// SwiftTerm rectangular edits replace independent CharData cells. They do
+/// not move the cursor, break logical rows, or alter images attached to rows.
+pub fn oshellRectangleFill(self: *Terminal, params: []const u16, scalar: u21, preserve_attributes: bool) !void {
+    const rect = self.oshellRectangle(params) orelse return;
+    const screen = self.screens.active;
+    const x = screen.cursor.x;
+    const y = screen.cursor.y;
+    const pending = screen.cursor.pending_wrap;
+    const original_style = screen.cursor.style;
+    defer {
+        screen.cursor.style = original_style;
+        screen.manualStyleUpdate() catch |err| {
+            log.warn("rectangle style restore failed: {}", .{err});
+            screen.cursor.style = .{};
+            screen.manualStyleUpdate() catch unreachable;
+        };
+        screen.cursorAbsolute(x, y);
+        screen.cursor.pending_wrap = pending;
+    }
+    for (rect.top..rect.bottom + 1) |row_index| {
+        if (preserve_attributes) for (rect.left..rect.right + 1) |col| {
+            screen.cursorAbsolute(@intCast(col), @intCast(row_index));
+            const cell = screen.cursor.page_cell.*;
+            const bg: style.Style.Color = switch (cell.content_tag) {
+                .bg_color_palette => .{ .palette = cell.content.color_palette.data },
+                .bg_color_rgb => .{ .rgb = .{ .r = cell.content.color_rgb.r, .g = cell.content.color_rgb.g, .b = cell.content.color_rgb.b } },
+                else => continue,
+            };
+            const old_page = screen.cursor.page_pin.node.page();
+            screen.cursor.style = if (cell.style_id == style.default_id) .{} else old_page.styles.get(old_page.memory, cell.style_id).*;
+            screen.cursor.style.bg_color = bg;
+            // Converting a compact blank to an explicit space may require more
+            // style capacity. Use the cursor path so page growth/splits are safe.
+            try screen.manualStyleUpdate();
+            const page = screen.cursor.page_pin.node.page();
+            const target = screen.cursor.page_cell;
+            if (target.style_id != style.default_id) page.styles.release(page.memory, target.style_id);
+            target.style_id = screen.cursor.style_id;
+            page.styles.use(page.memory, target.style_id);
+            target.content_tag = .codepoint;
+            target.content = .{ .codepoint = .{ .data = scalar } };
+            screen.cursor.page_row.styled = true;
+        };
+        screen.cursorAbsolute(0, @intCast(row_index));
+        const page = screen.cursor.page_pin.node.page();
+        const row = screen.cursor.page_row;
+        const all_cells = page.getCells(row);
+        const cells = all_cells[rect.left .. rect.right + 1];
+        page.pauseIntegrityChecks(true);
+        if (preserve_attributes) {
+            for (cells) |*cell| {
+                if (cell.hasGrapheme()) page.clearGrapheme(cell);
+                cell.content_tag = .codepoint;
+                cell.content = .{ .codepoint = .{ .data = scalar } };
+                cell.wide = .narrow;
+            }
+            page.updateRowGraphemeFlag(row);
+        } else {
+            screen.clearCells(page, row, cells);
+            @memset(cells, .{
+                .content_tag = .codepoint,
+                .content = .{ .codepoint = .{ .data = scalar } },
+                .style_id = screen.cursor.style_id,
+            });
+            if (screen.cursor.style_id != style.default_id) {
+                page.styles.useMultiple(page.memory, screen.cursor.style_id, @intCast(cells.len));
+                row.styled = true;
+            }
+        }
+        // An untouched zero-code tail stays blank with its original attributes.
+        // Its head may now have been replaced by an independent one-cell value.
+        if (rect.right + 1 < all_cells.len and all_cells[rect.right + 1].wide == .spacer_tail)
+            all_cells[rect.right + 1].wide = .narrow;
+        screen.cursorMarkDirty();
+        page.pauseIntegrityChecks(false);
+        page.assertIntegrity();
+    }
+}
