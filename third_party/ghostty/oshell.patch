+
+// Swift parseSemanticPromptOptions ignores unknown keys and bare fields, but
+// rejects the entire command for any malformed known value, even if a later
+// duplicate is valid. Validate UTF-8 before interpreting the option fields.
+fn oshellOptionsValid(raw: []const u8) bool {
+    if (!std.unicode.utf8ValidateSlice(raw)) return false;
+    var fields = std.mem.splitScalar(u8, raw, ';');
+    while (fields.next()) |field| {
+        const eq = std.mem.indexOfScalar(u8, field, '=') orelse continue;
+        const key = field[0..eq];
+        const value = field[eq + 1 ..];
+        if (std.mem.eql(u8, key, "k")) {
+            if (value.len != 1 or PromptKind.init(value[0]) == null) return false;
+        } else if (std.mem.eql(u8, key, "cl")) {
+            if (parseClick(value) == null) return false;
+        } else if (std.mem.eql(u8, key, "special_key")) {
+            if (!std.mem.eql(u8, value, "0") and !std.mem.eql(u8, value, "1")) return false;
+        } else if (std.mem.eql(u8, key, "click_events")) {
+            if (!std.mem.eql(u8, value, "0") and !std.mem.eql(u8, value, "1") and !std.mem.eql(u8, value, "2")) return false;
+        }
+    }
+    return true;
+}
