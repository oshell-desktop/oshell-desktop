+    pub fn clamp(self: *OshellSemanticRow, cols: u16) void {
+        if (cols == 0) {
+            self.present = 0;
+            return;
+        }
+        for (&self.marks) |*m| m.column = @min(m.column, cols - 1);
+    }
+
+    pub fn shift(self: *OshellSemanticRow, from: u16, delta: isize, right: u16) void {
+        for (&self.marks) |*m| {
+            if (m.column >= from and m.column <= right) {
+                m.column = @intCast(@min(@max(@as(isize, m.column) + delta, from), right));
+            }
+        }
+    }
+};
