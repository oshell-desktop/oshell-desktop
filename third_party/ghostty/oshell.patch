+test "Terminal vt OShell soft-wrap replay and pin map" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    for ([_][]const u8{
+        "abcdef\x1b#6ghijkl\x1b#3mnopqr\r\nend\x1b[?7l",
+        "abcdefghijklmnopqr\x1b[2;1H\x1b#4\x1b[2K\x1b[3;1H\x1b[?45h\x1b[?7l",
+    }) |input| {
+        var source = try Terminal.init(testing.io, alloc, .{ .cols = 6, .rows = 4 });
+        defer source.deinit(alloc);
+        source.oshell_reset_compatibility = true;
+        var source_stream = source.vtStream();
+        defer source_stream.deinit();
+        source_stream.nextSlice(input);
+        var builder: std.Io.Writer.Allocating = .init(alloc);
+        defer builder.deinit();
+        var map: PinMap.Map = .empty;
+        defer map.deinit(alloc);
+        var formatter = TerminalFormatter.init(&source, .{ .emit = .vt, .unwrap = true, .trim = false });
+        formatter.extra = .all;
+        formatter.pin_map = .{ .alloc = alloc, .map = &map };
+        try formatter.format(&builder.writer);
+        const output = builder.writer.buffered();
+        try testing.expectEqual(output.len, map.count());
+
+        var target = try Terminal.init(testing.io, alloc, .{ .cols = 6, .rows = 4 });
+        defer target.deinit(alloc);
+        target.oshell_reset_compatibility = true;
+        var target_stream = target.vtStream();
+        defer target_stream.deinit();
+        for (output) |byte| target_stream.nextSlice(&.{byte});
+        for (0..4) |y| {
+            const a = source.screens.active.pages.pin(.{ .screen = .{ .x = 0, .y = @intCast(y) } }).?.rowAndCell().row;
+            const b = target.screens.active.pages.pin(.{ .screen = .{ .x = 0, .y = @intCast(y) } }).?.rowAndCell().row;
+            try testing.expectEqual(a.wrap, b.wrap);
+            try testing.expectEqual(a.wrap_continuation, b.wrap_continuation);
+            try testing.expectEqual(a.oshell_render_mode, b.oshell_render_mode);
+        }
+        try testing.expectEqual(source.modes.get(.wraparound), target.modes.get(.wraparound));
+        try testing.expectEqual(source.modes.get(.reverse_wrap), target.modes.get(.reverse_wrap));
+    }
+}
