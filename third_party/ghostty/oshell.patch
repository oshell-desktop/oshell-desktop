+test "Screen: OSC 133 cross page scroll preserves semantic identity" {
+    const alloc = std.testing.allocator;
+    var s = try init(std.testing.io, alloc, .{ .cols = 10, .rows = 5, .max_scrollback_bytes = 10 });
+    defer s.deinit();
+    const capacity = s.pages.pages.first.?.capacity().rows;
+    s.pages.pages.first.?.page().pauseIntegrityChecks(true);
+    for (0..capacity - 3) |_| try s.testWriteString("\n");
+    s.pages.pages.first.?.page().pauseIntegrityChecks(false);
+    try s.testWriteString("1A\n2B\n3C\n4D\n5E");
+    s.cursorAbsolute(0, 2);
+    s.oshellBeginSemanticGroup();
+    s.oshellSetSemanticMark(.initial);
+    const identity = s.oshellSemanticRow().id;
+    const group = s.semantic_prompt.active_group;
+    s.oshellSemanticRow().hard_group = group;
+    s.oshellSemanticRow().has_hard_group = true;
+    s.cursorAbsolute(0, 1);
+    try std.testing.expect(s.cursor.page_pin.node != s.pages.pages.last.?);
+    try s.cursorScrollAbove();
+    try std.testing.expect(s.oshellSemanticOrigin() != null);
+    const origin = s.oshellSemanticOrigin().?;
+    try std.testing.expectEqual(@as(u32, 2), s.pages.pointFromPin(.active, origin).?.active.y);
+    const meta = origin.node.page().oshellSemantic(origin.rowAndCell().row);
+    try std.testing.expectEqual(identity, meta.id);
+    try std.testing.expectEqual(group, meta.mark(.initial).?.group);
+    try std.testing.expectEqual(group, meta.hard_group);
+    try std.testing.expect(meta.has_hard_group);
+    const blank = s.oshellSemanticRow();
+    try std.testing.expectEqual(@as(u64, 0), blank.id);
+    try std.testing.expectEqual(@as(u3, 0), blank.present);
+    try std.testing.expect(!blank.has_hard_group);
+    s.assertIntegrity();
+}
